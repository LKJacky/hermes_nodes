# hermes-node 配置示例（环境变量方式）
# 用法：export $(cat examples/node.env.example | grep -v '^#' | xargs)
#       或写入 systemd Environment= / launchd 的 EnvironmentVariables

# hub 地址（Tailscale IP 示例；同机调试用 http://127.0.0.1:9721）
HERMES_NODE_HUB=http://100.x.x.1:9721

# 共享 token（和 hub 端 HERMES_NODE_HUB_TOKEN 一致）
# 生成：openssl rand -hex 32
HERMES_NODE_TOKEN=replace-with-your-shared-token

# 设备名（显示在 nodes_list 里；默认主机名）
HERMES_NODE_DEVICE=devbox
